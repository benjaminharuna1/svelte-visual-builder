{
	"name": "svelte-builder",
	"version": "0.2.8",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@9.12.0",
	"engines": {
		"node": ">=20.19.0 <23",
		"pnpm": ">=9.12.0"
	},
	"scripts": {
		"dev": "pnpm --filter @builder/reference-studio dev",
		"build": "pnpm build:packages",
		"build:packages": "pnpm -r --filter \"./packages/*\" run build",
		"clean:packages": "pnpm -r --filter \"./packages/*\" run clean",
		"lint": "eslint .",
		"lint:packages": "pnpm -r --filter \"./packages/*\" exec publint --strict",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"audit:ci": "pnpm audit --prod --audit-level critical",
		"types:packages": "pnpm exec attw --pack packages/schema --profile esm-only && pnpm exec attw --pack packages/core --profile esm-only && pnpm exec attw --pack packages/plugin-api --profile esm-only && pnpm exec attw --pack packages/elementor-import --profile esm-only && pnpm exec attw --pack packages/adapter-sveltekit --profile esm-only && pnpm exec attw --pack packages/security --profile esm-only",
		"check:packages": "pnpm build:packages && pnpm lint:packages && pnpm types:packages",
		"smoke:packages": "tsx scripts/package-smoke.ts",
		"precheck": "pnpm build:packages",
		"check": "tsc --noEmit -p tsconfig.packages.json && pnpm --filter @builder/reference-studio check",
		"check:all": "pnpm build:packages && tsc --noEmit -p tsconfig.packages.json && pnpm -r --if-present check",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "changeset publish",
		"embed:validate": "pnpm check && pnpm test && pnpm test:e2e && pnpm --filter @builder/embed-smoke-host check && pnpm --filter @builder/embed-smoke-host build && playwright test -c playwright.embed.config.ts",
		"release:validate": "tsx scripts/run-release-validation.ts"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.55.0",
		"@sveltejs/adapter-auto": "^4.0.0",
		"@sveltejs/kit": "^2.20.7",
		"@sveltejs/package": "^2.3.10",
		"@sveltejs/vite-plugin-svelte": "^5.1.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.8",
		"@types/node": "^24.6.0",
		"csstype": "^3.2.3",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-security": "^4.2.1",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"jsdom": "^26.1.0",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.4.0",
		"prisma": "^6.6.0",
		"publint": "^0.3.25",
		"svelte": "^5.38.7",
		"svelte-check": "^4.1.7",
		"tslib": "^2.8.1",
		"tsx": "^4.20.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^6.3.5",
		"vitest": "^4.1.12",
		"zod": "^3.24.2"
	}
}
