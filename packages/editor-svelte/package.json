{
  "name": "@builder/editor-svelte",
  "version": "0.2.8",
  "license": "MIT",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@builder/core": "workspace:*",
    "@builder/elementor-import": "workspace:*",
    "@builder/plugin-api": "workspace:*",
    "@builder/runtime-svelte": "workspace:*",
    "@builder/schema": "workspace:*",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/svelte": "^0.4.0",
    "@floating-ui/dom": "1.7.6",
    "@tanstack/svelte-virtual": "3.13.24",
    "@tiptap/core": "^3.22.4",
    "@tiptap/extension-bubble-menu": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "bits-ui": "2.18.0",
    "paneforge": "^1.0.2",
    "svelte": "^5.38.7"
  }
}
